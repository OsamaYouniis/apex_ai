# ─── APEX AI — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── LLM API Keys (at least one required for AI chatbot) ───────────────────────
# Primary: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Fallback: OpenAI GPT-4o
OPENAI_API_KEY=sk-your-openai-key-here

# ── Authentication ──────────────────────────────────────────────────────────────
JWT_SECRET=apex_ai_super_secret_jwt_key_change_me_in_production_2025
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./apex_ai.db

# ── Kaggle API ──────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
