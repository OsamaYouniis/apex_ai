# ─── APEX AI — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── LLM API Keys (at least one required for AI chatbot) ───────────────────────
# Primary: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Fallback: OpenAI GPT-4o
OPENAI_API_KEY=sk-your-openai-key-here

# ── RAG LLM Provider (Groq or Gemini) ────────────────────────────────────────
# Options: groq | gemini
RAG_LLM_PROVIDER=groq

# Groq (Llama 3.x)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini 2.5 Flash
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# RAG storage
RAG_DOCS_DIR=knowledge_base/raw
RAG_INDEX_DIR=knowledge_base/faiss_index
RAG_ADMIN_KEY=change_me_for_reindex_endpoint

# ── Authentication ──────────────────────────────────────────────────────────────
JWT_SECRET=apex_ai_super_secret_jwt_key_change_me_in_production_2025
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./apex_ai.db

# ── Kaggle API ──────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
